HRManager --> UC6
HRManager --> UC7
HRManager --> UC8
HRManager --> UC9
HRManager --> UC15
HRManager --> UC16
HRManager --> UC17
HRManager --> UC18
HRManager --> UC19
HRManager --> UC20
HRManager --> UC21
HRManager --> UC22
HRManager --> UC23
HRManager --> UC24
HRManager --> UC25
HRManager --> UC26
HRManager --> UC27
HRManager --> UC29
HRManager --> UC31
HRManager --> UC32
HRManager --> UC33
HRManager --> UC36
HRManager --> UC37
HRManager --> UC38
HRManager --> UC39
HRManager --> UC40

' Admin relationships
Admin --> UC6
Admin --> UC9
Admin --> UC42
Admin --> UC43
Admin --> UC44

' System relationships
System --> UC11
System --> UC12
System --> UC13
System --> UC14
System --> UC22
System --> UC33
